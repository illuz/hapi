# Copy one file per service into docker/env/*.env on jiang2.
# Keep HAPI_PUBLIC_URL and CORS_ORIGINS equal to the final HTTPS domain.
HAPI_LISTEN_HOST=0.0.0.0
HAPI_LISTEN_PORT=3006
HAPI_HOME=/data
HAPI_PUBLIC_URL=https://replace-with-your-domain.example.com
CORS_ORIGINS=https://replace-with-your-domain.example.com
CLI_API_TOKEN=replace-with-a-long-random-token
